From 9557d3d9605680d929af302641c7e525b7aa2944 Mon Sep 17 00:00:00 2001
From: jmcinroy <jmcinroy@turing.ac.uk>
Date: Wed, 14 Oct 2026 11:16:49 +0000
Subject: [PATCH] Fix -inf/NaN KD loss from underflow in normalize_logprobs

normalize_logprobs renormalized top-k logprobs by converting them to
probabilities and back (exp, divide by the sum, log). In fp32, exp()
underflows to exactly 0 for any entry more than ~103 nats below the
row's maximum, so that entry came back as log(0) = -inf.

With kd_normalize_topk the student's top-k logprobs go through this
function. When the teacher's top-k includes a token the student rules
out almost entirely, the forward KL term becomes
p_teacher * (log p_teacher - (-inf)) = inf, and the backward pass
through log(exp(x)) at the underflowed entry gives inf * 0 = NaN. One
such position in a batch makes grad_norm NaN and corrupts the weights.

Renormalize in log space instead: logprobs - logsumexp(logprobs). This
is mathematically identical, matches log_softmax, and stays finite.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/axolotl/integrations/kd/utils.py          | 18 +----
 .../kd/test_normalize_logprobs.py             | 77 +++++++++++++++++++
 2 files changed, 81 insertions(+), 14 deletions(-)
 create mode 100644 tests/integrations/kd/test_normalize_logprobs.py

diff --git a/src/axolotl/integrations/kd/utils.py b/src/axolotl/integrations/kd/utils.py
index ba60694..08c6940 100644
--- a/src/axolotl/integrations/kd/utils.py
+++ b/src/axolotl/integrations/kd/utils.py
@@ -10,7 +10,7 @@ from torch import FloatTensor, Tensor
 
 def normalize_logprobs(logprobs: FloatTensor, topk: int) -> FloatTensor:
     """
-    Re-normalizes top-k raw logprobs as probabilities, and converts back to logprobs.
+    Re-normalizes top-k raw logprobs so they sum to 1 in probability space.
     """
     # Ensure raw_logprobs matches kd_online_topk length for tensor operations
     # This should ideally be handled by the caller ensuring correct padding/truncation first
@@ -28,19 +28,9 @@ def normalize_logprobs(logprobs: FloatTensor, topk: int) -> FloatTensor:
         )
         logprobs = torch.cat((logprobs, padding_tensor), dim=-1)
 
-    # Convert logprobs at T_online to probabilities
-    # use log sum exp trick to avoid underflow
-    position_logprobs_lse = torch.logsumexp(logprobs, dim=-1, keepdim=True)
-    teacher_probs_t_online = torch.exp(logprobs - position_logprobs_lse)
-
-    # Normalize probabilities (sum to 1)
-    # This is important if the top-k from server aren't a full distribution
-    teacher_probs_t_online_sum = teacher_probs_t_online.sum(dim=-1, keepdim=True)
-    teacher_probs_t_online = teacher_probs_t_online / teacher_probs_t_online_sum
-
-    final_logprobs_tensor = torch.log(teacher_probs_t_online)
-
-    return final_logprobs_tensor
+    # Stay in log space: a round trip through exp() underflows to log(0) = -inf
+    # for entries ~100 nats below the row max, which makes the KD loss NaN.
+    return logprobs - torch.logsumexp(logprobs, dim=-1, keepdim=True)
 
 
 def strided_chunk_views(
diff --git a/tests/integrations/kd/test_normalize_logprobs.py b/tests/integrations/kd/test_normalize_logprobs.py
new file mode 100644
index 0000000..e7d8c0f
--- /dev/null
+++ b/tests/integrations/kd/test_normalize_logprobs.py
@@ -0,0 +1,77 @@
+"""Tests for normalize_logprobs numerical stability"""
+
+import torch
+
+from axolotl.integrations.kd.kernels.liger import LigerFusedLinearKLTopKLogprobLoss
+from axolotl.integrations.kd.utils import normalize_logprobs
+
+
+def test_normalize_logprobs_matches_log_softmax():
+    torch.manual_seed(0)
+    logprobs = torch.randn(3, 5, 8) * 4
+
+    result = normalize_logprobs(logprobs, topk=8)
+
+    torch.testing.assert_close(result, torch.log_softmax(logprobs, dim=-1))
+    torch.testing.assert_close(result.exp().sum(-1), torch.ones(3, 5))
+
+
+def test_normalize_logprobs_pads_to_topk_with_neg_inf():
+    logprobs = torch.tensor([[-0.5, -1.5, -3.0]])
+
+    result = normalize_logprobs(logprobs, topk=5)
+
+    assert result.shape == (1, 5)
+    torch.testing.assert_close(result[:, :3], torch.log_softmax(logprobs, dim=-1))
+    assert torch.isneginf(result[:, 3:]).all()
+
+
+def test_normalize_logprobs_finite_far_below_max():
+    # exp(-120) underflows to 0 in fp32, so renormalizing via probabilities
+    # would turn this entry into log(0) = -inf.
+    logprobs = torch.tensor([[0.0, -1.0, -120.0]])
+
+    result = normalize_logprobs(logprobs, topk=3)
+
+    assert torch.isfinite(result).all()
+    torch.testing.assert_close(
+        result, logprobs - torch.logsumexp(logprobs, dim=-1, keepdim=True)
+    )
+
+
+def test_kd_loss_finite_when_student_rules_out_a_teacher_token():
+    """A teacher top-k token the student puts ~200 nats below its argmax must
+    not make the normalize_topk KD loss or its gradients inf/NaN."""
+    torch.manual_seed(0)
+    vocab_size, hidden_dim, seq_len, top_k = 16, 8, 3, 4
+    ruled_out = 5
+
+    hidden = torch.ones(1, seq_len, hidden_dim)
+    lm_head = torch.randn(vocab_size, hidden_dim) * 0.1
+    lm_head[ruled_out] = -25.0  # logit ~= -200 for every position
+    hidden.requires_grad_()
+    lm_head.requires_grad_()
+
+    target_token_ids = torch.tensor([[[0, 1, 2, ruled_out]] * seq_len])
+    target_logprobs = torch.log_softmax(
+        torch.tensor([[[0.0, -2.0, -4.0, -25.0]] * seq_len]), dim=-1
+    )
+    target_mask = torch.ones(1, seq_len, top_k, dtype=torch.bool)
+    true_labels = torch.zeros(1, seq_len, dtype=torch.long)
+
+    loss_fn = LigerFusedLinearKLTopKLogprobLoss(
+        weight_hard_loss=0.5,
+        weight_soft_loss=0.5,
+        temperature=1.0,
+        beta=0.0,
+        compiled=False,
+        normalize_topk=True,
+    )
+    loss = loss_fn(
+        lm_head, hidden, target_token_ids, target_logprobs, target_mask, true_labels
+    )
+    loss.backward()
+
+    assert torch.isfinite(loss)
+    assert torch.isfinite(hidden.grad).all()
+    assert torch.isfinite(lm_head.grad).all()
